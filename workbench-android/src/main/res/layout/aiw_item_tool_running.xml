<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#111A28"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#2A3750"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <com.cscjapp.aiworkbench.android.widget.DashedCircleLoadingView
                android:id="@+id/aiw_toolRunningLoadingView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp" />

            <TextView
                android:layout_marginLeft="10dp"
                android:id="@+id/aiw_tvToolRunningInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#DCEBFF"
                android:textSize="13sp" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
